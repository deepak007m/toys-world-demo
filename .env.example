# ============================================================
# Toys World — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to git. This .env.example IS safe to commit.
#
# Get these values from:
# Supabase Dashboard → Project Settings → API
# ============================================================

# ── Supabase ─────────────────────────────────────────────────

# Your Supabase project URL (e.g. https://xxxx.supabase.co)
VITE_SUPABASE_URL=your_supabase_project_url_here

# Your Supabase anon/public key (safe to expose in frontend code)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Deployment (Vercel) ──────────────────────────────────────
# These are set in the Vercel dashboard, not here.
# Documented here for reference only.
#
# VITE_SUPABASE_URL     → Vercel Environment Variable
# VITE_SUPABASE_ANON_KEY → Vercel Environment Variable
#
# In Vercel: Project → Settings → Environment Variables
# Set for: Production, Preview, and Development environments.

# ── Notes ────────────────────────────────────────────────────
# The VITE_ prefix is required for Vite to expose variables
# to the browser. Do NOT use the SERVICE ROLE KEY in the
# frontend — that stays server-side only (Admin API calls).
#
# If you later add a Supabase Edge Function for admin actions,
# the SERVICE_ROLE_KEY goes into that function's secrets, not here.
